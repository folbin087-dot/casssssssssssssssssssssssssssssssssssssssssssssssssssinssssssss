# Caddyfile for MoneyCas Casino
# Domain: moneycas.live
# Cloudflare Full (Strict) Mode with Let's Encrypt

{
    # Admin API
    admin localhost:2019
    
    # Email for Let's Encrypt
    email admin@moneycas.live
}

# Main domain with automatic HTTPS
moneycas.live {
    # 🔒 TLS 1.3 only for maximum security
    tls {
        protocols tls1.3
    }
    
    # 🛡 Security headers (Full Strict)
    header {
        # HSTS: Force HTTPS for 1 year
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        
        # XSS and content type protection
        X-Content-Type-Options "nosniff"
        X-XSS-Protection "1; mode=block"
        
        # Frame protection (SAMEORIGIN for Telegram WebApp)
        X-Frame-Options "SAMEORIGIN"
        
        # Referrer policy
        Referrer-Policy "strict-origin-when-cross-origin"
        
        # CSP for Telegram WebApp compatibility
        Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://telegram.org https://*.telegram.org https://static.cloudflareinsights.com https://va.vercel-scripts.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: https: blob:; connect-src 'self' https://api.coingecko.com https://api.coincap.io https://api.exchangerate-api.com https://plaidprocessing.com https://api.telegram.org wss: https://*.cloudflareinsights.com; frame-ancestors 'self' https://telegram.org https://*.telegram.org; upgrade-insecure-requests"
        
        # Remove server header
        -Server
    }
    
    # Compression
    encode gzip zstd
    
    # Reverse proxy to Next.js
    reverse_proxy localhost:3000 {
        # Forward real client IP from Cloudflare
        header_up Host {host}
        header_up X-Real-IP {header.CF-Connecting-IP}
        header_up X-Forwarded-For {header.CF-Connecting-IP}
        header_up X-Forwarded-Proto {scheme}
        
        # Health check
        health_uri /
        health_interval 30s
        health_timeout 10s
    }
    
    # Static files caching
    @static {
        path *.js *.css *.png *.jpg *.jpeg *.gif *.ico *.svg *.woff *.woff2 *.ttf *.eot *.webp
    }
    header @static Cache-Control "public, max-age=31536000, immutable"
    
    # Logging
    log {
        output file /var/snap/caddy/common/logs/moneycas.log {
            roll_size 10MB
            roll_keep 5
        }
        format json
        level INFO
    }
}

# WWW redirect
www.moneycas.live {
    tls {
        protocols tls1.3
    }
    redir https://moneycas.live{uri} permanent
}

# HTTP to HTTPS redirect
http://moneycas.live, http://www.moneycas.live {
    redir https://moneycas.live{uri} permanent
}
