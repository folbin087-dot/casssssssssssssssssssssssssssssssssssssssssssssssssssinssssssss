# ===========================================
# BlessCas Casino Configuration
# ===========================================
#
# Copy this file to .env.local and fill in real values.
# NEVER commit real secrets – this file is checked into git.

# Site Configuration
NEXT_PUBLIC_APP_URL=https://moneycas.live
NEXT_PUBLIC_SITE_NAME=Bless Casino
CASINO_NAME=Bless Casino

# PLAIDEX Payment API
# Get keys from your PLAIDEX partner dashboard.
PLAIDEX_API_KEY=your_plaidex_api_key_here
PLAIDEX_API_SECRET=your_plaidex_api_secret_here

# ===========================================
# Telegram Bot Settings
# ===========================================
# Create a bot via @BotFather, then paste its HTTP API token here.
# Required on the server to validate Telegram Mini App initData signatures.
TELEGRAM_BOT_TOKEN=123456789:PUT_YOUR_BOT_TOKEN_HERE
TELEGRAM_BOT_USERNAME=your_bot_username

# Admin Settings (comma-separated Telegram user IDs)
ADMIN_IDS=
SUPER_ADMIN_IDS=
# These are exposed to the client; only put public-safe numeric IDs here.
NEXT_PUBLIC_ADMIN_IDS=
NEXT_PUBLIC_SUPER_ADMIN_IDS=

# ===========================================
# Casino Settings
# ===========================================
MIN_BET=10
MAX_BET=500000
DEFAULT_BALANCE=0

# Payment Settings
CASINO_TON_WALLET=
NEXT_PUBLIC_CASINO_TON_WALLET=

# Feature Flags
ENABLE_TON_PAYMENTS=true
ENABLE_SBP_PAYMENTS=false
ENABLE_BONUSES=true
ENABLE_REFERRALS=true
MAINTENANCE_MODE=false

# Deposit Limits
MIN_DEPOSIT=50
MAX_DEPOSIT=50000
